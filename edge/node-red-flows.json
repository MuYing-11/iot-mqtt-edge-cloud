 {
  "id": "fn000d",
  "type": "function",
  "z": "tabedge01",
  "name": "route per sensor",
  "func": "// split raw / filtered messages per sensor -> [chart, gauge] outputs.\n// The chart colours its series by order of first appearance, so every raw point is\n// sent right after the value currently held at the edge output (filtered first).\nconst sensors = [\"temperature\", \"humidity\", \"pressure\", \"co2\"];\nconst parts = msg.topic.split('/');\nconst i = sensors.indexOf(parts[1]);\nif (i < 0 || typeof msg.payload.value !== 'number') return null;\nconst out = new Array(sensors.length * 2).fill(null);\nconst v = Math.round(msg.payload.value * 100) / 100;\nif (parts[2] === 'filtered') {\n    context.set(parts[1], v);\n    out[2 * i + 1] = { payload: v };\n    return out;\n}\nconst held = context.get(parts[1]);\nif (held === undefined) return null;\nout[2 * i] = [{ topic: 'filtered (edge → cloud)', payload: held }, { topic: 'raw (sensor → edge)', payload: v }];\nreturn out;",
  "outputs": 8,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 560,
  "y": 160,
  "wires": [
   [
    "cht0002"
   ],
   [
    "gau0003"
   ],
   [
    "cht0005"
   ],
   [
    "gau0006"
   ],
   [
    "cht0008"
   ],
   [
    "gau0009"
   ],
   [
    "cht000b"
   ],
   [
    "gau000c"
   ]
  ]
 },
 {
  "id": "fn000e",
  "type": "function",
  "z": "tabedge01",
  "name": "decimate raw",
  "func": "const k = msg.topic;\nconst n = (context.get(k) || 0) + 1;\ncontext.set(k, n);\nreturn n % 2 ? msg : null;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 360,
  "y": 80,
  "wires": [
   [
    "fn000d"
   ]
  ]
 },
